{
  "name": "Existing Docker Compose (Extend)",
  "dockerComposeFile": [
    "../docker-compose.yml",
    "docker-compose.yml"
  ],
  "service": "mqtt-logger",
  "workspaceFolder": "/app",

  "mounts": [
    // bind your host's SSH socket into /ssh-agent in the container
    "source=${env:SSH_AUTH_SOCK},target=/ssh-agent,type=bind,consistency=cached"
  ],

  "containerEnv": {
    // point SSH tooling at the forwarded socket
    "SSH_AUTH_SOCK": "/ssh-agent"
  },

  "postCreateCommand": "poetry install --with dev && pre-commit install",
  "remoteUser": "root"
}
